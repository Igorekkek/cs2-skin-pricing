# Copy to .env (ignored by git) and adjust.

# Where datasets, feature tables, trained models and snapshots are stored.
# Defaults to ./workspace inside the repository.
SKINPRICE_WORKSPACE=./workspace

# SQLite database produced by the collector (`skinprice collect`).
SKINPRICE_SOURCE_DB=./workspace/csfloat_history.db

# Optional: CSFloat API key, needed only to collect data or to fetch a listing by id.
CSFLOAT_API_KEY=
